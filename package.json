{
	"name": "ffz-emoji",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"description": "Builds the emoji data, images, and sprite sheets used by the FrankerFaceZ client.",
	"author": "SirStendec <sir@stendec.me>",
	"license": "MIT",
	"packageManager": "pnpm@10.34.9",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"tools": "node src/cli/install-tools.ts",
		"sources": "node src/cli/fetch-sources.ts",
		"sources:check": "node src/cli/check-updates.ts",
		"data": "node src/cli/build-data.ts",
		"images": "node src/cli/build-images.ts",
		"check": "node src/cli/check.ts",
		"build": "pnpm sources && pnpm data && pnpm images && pnpm check",
		"typecheck": "tsc",
		"test": "node --test \"test/**/*.test.ts\""
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.52",
		"emojibase": "18.0.0",
		"emojibase-data": "18.0.0",
		"fastest-levenshtein": "^1.0.16",
		"fflate": "^0.8.3",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2"
	}
}
